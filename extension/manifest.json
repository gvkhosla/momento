{
  "manifest_version": 3,
  "name": "momento",
  "version": "0.2.0",
  "description": "Sync X Hearts and Bookmarks into your searchable Momento archive."
  "permissions": [
    "cookies",
    "webRequest",
    "tabs",
    "declarativeNetRequest",
    "storage"
  ],
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "momento"
  }
}
